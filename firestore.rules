rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users - can read any user, create/update their own
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false; // Users cannot delete their account via client
    }

    // Posts - anyone authenticated can read, owner can create/update/delete
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Gatherings/Events
    match /gatherings/{gatheringId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.organizerId;
    }

    // Comments
    match /comments/{commentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Tips - users can read their own sent/received tips
    match /tips/{tipId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.creatorId);
      // Tips are created by Cloud Functions only
      allow write: if false;
    }

    // Votes - managed by Cloud Functions for consistency
    match /votes/{voteId} {
      allow read: if request.auth != null;
      // Votes are created/updated by Cloud Functions only
      allow write: if false;
    }

    // Cleanup Jobs (legacy)
    match /jobs/{jobId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == resource.data.reportedBy;
    }

    // Cleanup Jobs (new map-based requests)
    match /cleanupJobs/{jobId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.creatorId == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.creatorId == request.auth.uid ||
        resource.data.claimedBy == request.auth.uid ||
        request.resource.data.claimedBy == request.auth.uid
      );
      allow delete: if request.auth != null && resource.data.creatorId == request.auth.uid;
    }

    // Event Comments (Discussions)
    match /eventComments/{commentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.authorId;
    }

    // Event Comment Votes
    match /eventCommentVotes/{voteId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Event Supplies
    match /eventSupplies/{supplyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == resource.data.requesterId;
    }

    // Supply Contributions
    match /supplyContributions/{contributionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.contributorId;
    }

    // Event Tasks
    match /eventTasks/{taskId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == resource.data.creatorId;
    }

    // Task Volunteers
    match /taskVolunteers/{volunteerId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Event RSVPs
    match /eventRSVPs/{rsvpId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
  }
}
