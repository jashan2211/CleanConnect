    "Our team reviews every report within 24 hours and removes content that breaks the community guidelines. Content reported by several people is hidden automatically.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हमारी टीम हर रिपोर्ट 24 घंटे के अंदर देखती है और दिशानिर्देश तोड़ने वाली सामग्री हटा देती है। कई लोगों द्वारा रिपोर्ट की गई सामग्री अपने आप छिप जाती है।"
          }
        }
      }
    },
