    "Spots in this area": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस इलाक़े की जगहें"
          }
        }
      }
    },
    "Spotted garbage on your street? Be the first to report it.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी गली में कचरा दिखा? सबसे पहले रिपोर्ट करें।"
          }
        }
      }
    },
    "Spotted garbage? Snap it and put it on the map.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कचरा दिखा? फ़ोटो लें और मैप पर डालें।"
          }
        }
      }
    },
    "Spread the word": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सबको बताएँ"
          }
        }
      }
    },
    "Start": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शुरू करें"
          }
        }
      }
    },
    "Start a cleanup drive, invite friends on WhatsApp and climb the city leaderboard together. Bharat gets cleaner one spot at a time.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सफ़ाई अभियान शुरू करें, WhatsApp पर दोस्तों को बुलाएँ और मिलकर शहर के लीडरबोर्ड पर चढ़ें। एक-एक जगह से भारत साफ़ होता है।"
          }
        }
      }
    },
    "Start one. Friends join on WhatsApp in a tap.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक शुरू करें। दोस्त WhatsApp से एक टैप में जुड़ जाते हैं।"
          }
        }
      }
    },
    "Starts": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शुरू"
          }
        }
      }
    },
    "State": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "राज्य"
          }
        }
      }
    },
    "Stay safe: wear gloves, don't touch sharp objects or medical waste with bare hands, and avoid traffic.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुरक्षित रहें: दस्ताने पहनें, नुकीली चीज़ें या मेडिकल कचरा नंगे हाथों से न छुएँ, और ट्रैफ़िक से बचें।"
          }
        }
      }
    },
    "Still dirty": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अब भी गंदा"
          }
        }
      }
    },
    "Still setting up your profile — try again in a moment.": {
      "localizations": {
        "hi": {
          "stringUnit": {
