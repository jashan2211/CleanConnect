          "stringUnit": {
            "state": "translated",
            "value": "और बताएँ"
          }
        }
      }
    },
    "Tell us your name and city so you show up on your city's leaderboard.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना नाम और शहर बताएँ ताकि आप अपने शहर के लीडरबोर्ड पर दिखें।"
