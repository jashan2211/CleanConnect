          "stringUnit": {
            "state": "translated",
            "value": "स्वयंसेवक"
          }
        }
      }
    },
    "Volunteers can chip in for gloves and bags directly through their UPI app. 100% goes to you, and CleanConnect never handles the money.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वयंसेवक अपने UPI ऐप से सीधे दस्ताने और बैग के लिए योगदान दे सकते हैं। 100% आपको मिलता है, CleanConnect पैसों को कभी नहीं छूता।"
          }
        }
      }
    },
    "Volunteers who joined will see it as cancelled.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जुड़े हुए स्वयंसेवकों को यह रद्द दिखेगा।"
          }
        }
      }
    },
