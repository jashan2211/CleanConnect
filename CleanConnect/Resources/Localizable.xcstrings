          }
        }
      }
    },
    "Thanks for cleaning": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सफ़ाई के लिए धन्यवाद"
          }
        }
      }
    },
    "Thanks for verifying! +%lld pts": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पुष्टि के लिए धन्यवाद! +%lld पॉइंट्स"
          }
        }
      }
    },
    "Thanks. We'll review it within 24 hours.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "धन्यवाद। हम 24 घंटे के अंदर इसकी जाँच करेंगे।"
          }
        }
      }
    },
    "That doesn't look like a UPI ID (e.g. name@okaxis).": {
      "localizations": {
