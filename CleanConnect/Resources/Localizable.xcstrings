    },
    "Change cover photo": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कवर फ़ोटो बदलें"
          }
        }
      }
    },
    "Chip in for gloves, bags and water for this drive.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस अभियान के दस्ताने, बैग और पानी में योगदान दें।"
          }
        }
      }
    },
    "Chip in for supplies via UPI": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "UPI से सामान के लिए योगदान दें"
          }
        }
      }
    },
    "Choose meeting point": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मिलने की जगह चुनें"
          }
        }
      }
    },
    "Choose on map": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैप पर चुनें"
          }
        }
      }
    },
    "City": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शहर"
          }
        }
      }
    },
    "Claim a spot, clean it, and post the after photo. Your before/after goes in the feed and earns you Swachh Points.": {
      "localizations": {
        "hi": {
          "stringUnit": {
