    "All India": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरा भारत"
          }
        }
      }
    },
    "All time": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अब तक"
          }
        }
      }
    },
    "Allow location to see dirty spots and drives around you, and to pin your reports accurately. We never share your live location.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आसपास की गंदी जगहें और अभियान देखने और अपनी रिपोर्ट सही जगह पिन करने के लिए लोकेशन की अनुमति दें। हम आपकी लाइव लोकेशन कभी साझा नहीं करते।"
          }
        }
      }
    },
    "Already cleaned": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साफ़ कर दिया"
          }
        }
      }
    },
    "Amount (optional)": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "राशि (वैकल्पिक)"
          }
        }
      }
    },
    "Any amount": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई भी राशि"
          }
        }
      }
    },
    "Anything else? (optional)": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ और? (वैकल्पिक)"
          }
        }
      }
    },
    "Apple sign-in failed. Please try again.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple साइन-इन नहीं हो पाया। कृपया फिर से कोशिश करें।"
          }
        }
      }
    },
    "Around here": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आसपास"
          }
        }
      }
    },
    "Ask neighbours to tap “Still dirty” on the spot. More confirmations make a stronger case.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पड़ोसियों से कहें कि इस जगह पर “अब भी गंदा” दबाएँ। जितनी ज़्यादा पुष्टि, उतनी मज़बूत शिकायत।"
          }
        }
      }
    },
    "Awesome!": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बहुत बढ़िया!"
          }
        }
      }
    },
    "BEFORE": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले"
          }
        }
      }
    },
    "Badges": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैज"
          }
        }
      }
    },
    "Bags of waste collected": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कचरे के बैग इकट्ठा किए"
          }
        }
      }
    },
    "Be one of the first cleaners in your city. Report a spot or clean one today.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने शहर के पहले सफ़ाई वीरों में शामिल हों। आज ही कोई जगह रिपोर्ट करें या साफ़ करें।"
          }
        }
      }
    },
    "Be the first to join!": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सबसे पहले जुड़ें!"
          }
        }
      }
    },
    "Be the one who gets the mohalla together. It takes a minute to set up.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मोहल्ले को एक साथ लाने वाले बनिए। बनाने में बस एक मिनट लगता है।"
          }
        }
      }
    },
    "Before": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले"
          }
        }
      }
    },
    "Before & after": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले और बाद"
          }
        }
      }
    },
    "Before and after photos": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले और बाद की फ़ोटो"
          }
        }
      }
    },
    "Before → After": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले → बाद"
          }
        }
      }
    },
    "Before → after at %@! Cleaned with CleanConnect. Join in: %@": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ पर पहले → बाद! CleanConnect के साथ साफ़ किया। आप भी जुड़ें: %2$@"
          }
        }
      }
    },
    "Block": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ब्लॉक करें"
          }
        }
      }
    },
    "Block %@": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ को ब्लॉक करें"
          }
        }
      }
    },
    "Block organiser": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आयोजक को ब्लॉक करें"
          }
        }
      }
    },
    "Blocked drain": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बंद नाली"
          }
        }
      }
    },
    "Blocked people": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ब्लॉक किए गए लोग"
          }
        }
      }
    },
    "Blocked. You won't see their posts anymore.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ब्लॉक कर दिया। अब आपको उनकी पोस्ट नहीं दिखेंगी।"
          }
        }
      }
    },
    "Bring a friend": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोस्त को लाएँ"
          }
        }
      }
    },
    "Bring along": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साथ लाएँ"
          }
        }
      }
    },
    "Brooms & rakes": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "झाड़ू और रेक"
          }
        }
      }
    },
    "By continuing you agree to our [Terms](%@), [Community Guidelines](%@) and [Privacy Policy](%@). There's zero tolerance for abusive content or users.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आगे बढ़कर आप हमारी [शर्तों](%1$@), [सामुदायिक दिशानिर्देशों](%2$@) और [गोपनीयता नीति](%3$@) से सहमत होते हैं। अपमानजनक सामग्री या उपयोगकर्ताओं के लिए कोई जगह नहीं है।"
          }
        }
      }
    },
    "Camera": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैमरा"
          }
        }
      }
    },
    "Can you help clean it? Find it on the CleanConnect map.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आप इसे साफ़ करने में मदद करेंगे? CleanConnect मैप पर देखें।"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रद्द करें"
          }
        }
      }
    },
    "Cancel drive": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभियान रद्द करें"
          }
        }
      }
    },
    "Cancel this drive?": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह अभियान रद्द करें?"
          }
        }
      }
    },
    "Cap or hat": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टोपी"
          }
        }
      }
    },
    "Cart-load": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ठेला भर"
          }
        }
