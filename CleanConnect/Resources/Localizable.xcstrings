{
  "sourceLanguage": "en",
  "strings": {
    "%.1f hr": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%.1f घंटे"
          }
        }
      }
    },
    "%@ away": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ दूर"
          }
        }
      }
    },
    "%@ hasn't added a UPI ID yet. Send some respect instead 🙏": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ने अभी UPI ID नहीं जोड़ी है। बदले में सम्मान भेजें 🙏"
          }
        }
      }
    },
    "%@ is getting cleaner": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ साफ़ हो रहा है"
          }
        }
      }
    },
    "%@ is on it. You can still help or post the cleanup.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ इस पर काम कर रहे हैं। आप भी मदद कर सकते हैं या सफ़ाई पोस्ट कर सकते हैं।"
          }
        }
      }
    },
    "%@ starts at %@. See you at %@!": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ बजे शुरू होगा। %3$@ पर मिलते हैं!"
          }
        }
      }
    },
    "%lld": {
