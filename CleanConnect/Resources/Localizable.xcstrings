      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "100 बैग"
          }
        }
      }
    },
    "100%% goes directly to %@. CleanConnect takes nothing and never sees your payment.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "100%% सीधे %@ को जाता है। CleanConnect कुछ नहीं लेता और आपका भुगतान कभी नहीं देखता।"
          }
        }
      }
    },
    "7-Day Streak": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "7 दिन की स्ट्रीक"
          }
        }
      }
    },
    "@%@": {
      "shouldTranslate": false
    },
    "A concerned resident": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक जागरूक निवासी"
          }
        }
      }
    },
    "A few bags": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ बैग"
          }
        }
      }
    },
    "A photo is attached. Thank you for your support in keeping our city clean.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटो संलग्न है। हमारे शहर को साफ़ रखने में आपके सहयोग के लिए धन्यवाद।"
          }
        }
      }
    },
    "AFTER": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बाद में"
          }
        }
      }
    },
